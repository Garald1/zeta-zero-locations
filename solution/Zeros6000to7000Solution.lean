theorem hP_post : ∀ m ∈ post, ZetaCert.Assembly.P m := by simp [post]

theorem hP : ∀ m ∈ ws, ZetaCert.Assembly.P m := by
  intro m hm
  simp only [ws, ordinates, List.nil_append, List.mem_append] at hm
  rcases hm with (((hm | hm) | hm) | hm) | hm
  · exact hP_ord0 m hm
  · exact hP_ord1 m hm
  · exact hP_ord2 m hm
  · exact hP_ord3 m hm
  · exact hP_post m hm

theorem hchain : ws.IsChain (fun a b => a + 30000 < b) := by decide +kernel

instance : Trans (fun a b : ℕ => a + 30000 < b) (fun a b : ℕ => a + 30000 < b)
    (fun a b : ℕ => a + 30000 < b) := ⟨fun h1 h2 => by omega⟩

theorem hsep : ZetaCert.Assembly.Sep ws := List.isChain_iff_pairwise.mp hchain

theorem hrange : ∀ m ∈ ws, 6000000000000000000000000000 + 10 ^ 5 < m ∧ m + 10 ^ 5 < 7000000000000000000000000000 := by
  have h : ws.all (fun m => decide (6000000000000000000000000000 + 10 ^ 5 < m ∧ m + 10 ^ 5 < 7000000000000000000000000000)) = true := by
    decide +kernel
  intro m hm
  simpa using List.all_eq_true.mp h m hm

theorem hlen : ordinates.length = 1105 := by decide +kernel

theorem hlenws : ws.length = 1105 := by decide +kernel

theorem whyp : ZetaCert.Window.WHyp ws ((6000 : ℝ) / 1) ((7000 : ℝ) / 1) 6000000000000000000000000000 7000000000000000000000000000 :=
  ⟨hP, hsep, hrange, by norm_num, by norm_num, by norm_num,
    by rw [hlenws, ZetaCert.Windows.W6000to7000.ncount]⟩

theorem rhyp : ZetaCert.Window.RHyp [] ordinates post 6000 7000 ((6000 : ℝ) / 1) ((7000 : ℝ) / 1) := by
  refine ⟨by norm_num, by norm_num, ?_, by simp, ?_⟩
  · have h : ordinates.all (fun m => decide (6000 * 10 ^ 24 + 10 ^ 5 < m ∧ m + 10 ^ 5 < 7000 * 10 ^ 24)) = true := by
      decide +kernel
    intro m hm
    simpa using List.all_eq_true.mp h m hm
  · have h : post.all (fun m => decide (7000 * 10 ^ 24 + 10 ^ 5 < m)) = true := by decide +kernel
    intro m hm
    simpa using List.all_eq_true.mp h m hm

/-- Every zero of `ζ` with `6000 < Im s ≤ 7000` is simple, lies on the critical line, and has its
ordinate within `10⁻²⁰` of `m / 10²⁴` for some `m` in the list. -/
theorem located :
    ∀ s ∈ zerosBetween 6000 7000, s.re = 1 / 2 ∧ analyticOrderAt riemannZeta s = 1 ∧
      ∃ m ∈ ordinates, |s.im - (m : ℝ) / 10 ^ 24| ≤ 1 / 10 ^ 20 := by
  rintro s ⟨hz, ha, hb⟩
  exact ZetaCert.Window.range_located whyp rhyp s hz (by exact_mod_cast ha) (by exact_mod_cast hb)

/-- For each listed `m`, exactly one zero of `ζ` has its ordinate within `10⁻²⁰` of `m / 10²⁴`. -/
theorem unique :
    ∀ m ∈ ordinates, ∃! s : ℂ, riemannZeta s = 0 ∧ |s.im - (m : ℝ) / 10 ^ 24| ≤ 1 / 10 ^ 20 :=
  ZetaCert.Window.range_unique whyp rhyp

/-- There are exactly 1105 zeros of `ζ` with `6000 < Im s ≤ 7000`. -/
theorem count : (zerosBetween 6000 7000).ncard = 1105 := by
  have h := ZetaCert.Window.range_count whyp rhyp
  push_cast at h
  unfold zerosBetween
  rw [h, hlen]

end Zeros6000to7000
