theorem rhyp : ZetaCert.Window.RHyp [] ordinates post 7000 7500 ((7000 : ℝ) / 1) ((7500 : ℝ) / 1) := by
  refine ⟨by norm_num, by norm_num, ?_, by simp, ?_⟩
  · have h : ordinates.all (fun m => decide (7000 * 10 ^ 24 + 10 ^ 5 < m ∧ m + 10 ^ 5 < 7500 * 10 ^ 24)) = true := by
