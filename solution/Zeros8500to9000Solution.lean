    by rw [hlenws, ZetaCert.Windows.W8500to9000.ncount]⟩

theorem rhyp : ZetaCert.Window.RHyp [] ordinates post 8500 9000 ((8500 : ℝ) / 1) ((9000 : ℝ) / 1) := by
  refine ⟨by norm_num, by norm_num, ?_, by simp, ?_⟩
  · have h : ordinates.all (fun m => decide (8500 * 10 ^ 24 + 10 ^ 5 < m ∧ m + 10 ^ 5 < 9000 * 10 ^ 24)) = true := by
      decide +kernel
    intro m hm
    simpa using List.all_eq_true.mp h m hm
  · have h : post.all (fun m => decide (9000 * 10 ^ 24 + 10 ^ 5 < m)) = true := by decide +kernel
    intro m hm
    simpa using List.all_eq_true.mp h m hm

/-- Every zero of `ζ` with `8500 < Im s ≤ 9000` is simple, lies on the critical line, and has its
ordinate within `10⁻²⁰` of `m / 10²⁴` for some `m` in the list. -/
theorem located :
    ∀ s ∈ zerosBetween 8500 9000, s.re = 1 / 2 ∧ analyticOrderAt riemannZeta s = 1 ∧
      ∃ m ∈ ordinates, |s.im - (m : ℝ) / 10 ^ 24| ≤ 1 / 10 ^ 20 := by
  rintro s ⟨hz, ha, hb⟩
  exact ZetaCert.Window.range_located whyp rhyp s hz (by exact_mod_cast ha) (by exact_mod_cast hb)

/-- For each listed `m`, exactly one zero of `ζ` has its ordinate within `10⁻²⁰` of `m / 10²⁴`. -/
theorem unique :
    ∀ m ∈ ordinates, ∃! s : ℂ, riemannZeta s = 0 ∧ |s.im - (m : ℝ) / 10 ^ 24| ≤ 1 / 10 ^ 20 :=
  ZetaCert.Window.range_unique whyp rhyp

/-- There are exactly 576 zeros of `ζ` with `8500 < Im s ≤ 9000`. -/
theorem count : (zerosBetween 8500 9000).ncard = 576 := by
  have h := ZetaCert.Window.range_count whyp rhyp
  push_cast at h
  unfold zerosBetween
  rw [h, hlen]

end Zeros8500to9000
