import ZetaCert.LegCertSound

/-!
# Positivity of `Re ζ` on a horizontal segment, from finitely many leg points

* `norm_zeta''_le_leg`: `‖ζ''(z)‖ ≤ M2 m T` for `Re z ≥ 7/16`, `|Im z - T| ≤ 1/16`
  (rh-up-to-15's `norm_deriv_deriv_zeta_le` with `N = m^4`, `σ₀ = 1/4`, `R = 3/16`);
* `re_pos_of_point`: `Re ζ(c) ≥ v`, `‖ζ'(c)‖ ≤ d`, `‖ζ''‖ ≤ M` on `closedBall c h` and
  `h d + h² M < v` give `Re ζ > 0` on that ball;
* `seg_of_lc`: the same from a leg-point certificate `lc`;
* `cover2`: gluing two overlapping intervals.
-/

open Complex Metric Set

namespace ZetaCert

open ZetaZeros.Deriv

/-- The bound for `|ζ''|` near the horizontal line `Im s = T`. -/
noncomputable def M2 (m : ℕ) (T : ℝ) : ℝ :=
  2 * ((m : ℝ) ^ 4 + (m : ℝ) ^ 3 / (T - 2) + 1 / (2 * m) + (1 + 4 * (T + 1 / 4)) / m) / (3 / 16) ^ 2

theorem norm_zeta''_le_leg {m : ℕ} (hm : 1 ≤ m) {T : ℝ} (hT : 10 ≤ T) {z : ℂ} (hz : 7 / 16 ≤ z.re)
    (hzi : |z.im - T| ≤ 1 / 16) : ‖deriv (deriv riemannZeta) z‖ ≤ M2 m T := by
  have hmR : (1 : ℝ) ≤ m := by exact_mod_cast hm
  have hm0 : (0 : ℝ) < m := by linarith
  rw [abs_le] at hzi
  have h := norm_deriv_deriv_zeta_le (m ^ 4) (Nat.one_le_pow _ _ (by omega)) (σ₀ := 1 / 4)
    (T₀ := T + 1 / 4) (δ := T - 2) (R := 3 / 16) (by norm_num) (by linarith) (by norm_num) (z := z)
    (by linarith) ?_ ?_
  · refine h.trans (le_of_eq ?_) |>.trans ?_
    · exact 2 * ((∑ k ∈ Finset.Icc 1 (m ^ 4), (k : ℝ) ^ (-(1 / 4 : ℝ))) + ((m ^ 4 : ℕ) : ℝ) ^ (1 - 1 / 4 : ℝ) / (T - 2)
        + ((m ^ 4 : ℕ) : ℝ) ^ (-(1 / 4 : ℝ)) / 2 + (1 + (T + 1 / 4) / (1 / 4)) * ((m ^ 4 : ℕ) : ℝ) ^ (-(1 / 4 : ℝ)))
        / (3 / 16) ^ 2
    · rfl
    have hN : ((m ^ 4 : ℕ) : ℝ) = (m : ℝ) ^ 4 := by push_cast; ring
    have hq : ((m : ℝ) ^ 4) ^ (-(1 / 4 : ℝ)) = 1 / m := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hm0.le]; norm_num; rw [Real.rpow_neg_one, one_div]
    have hq3 : ((m : ℝ) ^ 4) ^ (1 - 1 / 4 : ℝ) = (m : ℝ) ^ 3 := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hm0.le]; norm_num
      rw [show (3 : ℝ) = ((3 : ℕ) : ℝ) by norm_num, Real.rpow_natCast]
    have hsum : ∑ k ∈ Finset.Icc 1 (m ^ 4), (k : ℝ) ^ (-(1 / 4 : ℝ)) ≤ (m : ℝ) ^ 4 := by
      calc ∑ k ∈ Finset.Icc 1 (m ^ 4), (k : ℝ) ^ (-(1 / 4 : ℝ)) ≤ ∑ k ∈ Finset.Icc 1 (m ^ 4), (1 : ℝ) := by
            apply Finset.sum_le_sum; intro k hk
            have : (1 : ℝ) ≤ k := by exact_mod_cast (Finset.mem_Icc.mp hk).1
            exact Real.rpow_le_one_of_one_le_of_nonpos this (by norm_num)
        _ = (m : ℝ) ^ 4 := by simp
    rw [hN, hq, hq3]
    unfold M2
    have hT2 : 0 < T - 2 := by linarith
    have e : (1 + (T + 1 / 4) / (1 / 4)) * (1 / (m : ℝ)) = (1 + 4 * (T + 1 / 4)) / m := by field_simp; ring
    have e2 : (1 / (m : ℝ)) / 2 = 1 / (2 * m) := by field_simp
    rw [e, e2]
    gcongr
  · rw [abs_le]; constructor <;> linarith
  · have h1 : T - 2 + 3 / 16 ≤ |(z - 1).im| := by
      simp only [Complex.sub_im, Complex.one_im, sub_zero]
      rw [abs_of_pos (by linarith)]; linarith
    exact h1.trans (Complex.abs_im_le_norm _)

theorem re_pos_of_point {c : ℂ} {v d M h : ℝ} (hv : v ≤ (riemannZeta c).re)
    (hd : ‖deriv riemannZeta c‖ ≤ d) (hh : 0 ≤ h)
    (hM : ∀ z ∈ closedBall c h, ‖deriv (deriv riemannZeta) z‖ ≤ M)
    (h1 : ∀ z ∈ closedBall c h, z ≠ 1) (hpos : h * d + h ^ 2 * M < v) :
    ∀ z ∈ closedBall c h, 0 < (riemannZeta z).re := by
  intro z hz
  have hcD : c ∈ closedBall c h := mem_closedBall_self hh
  have hconv := convex_closedBall c h
  have hd0 : 0 ≤ d := (norm_nonneg _).trans hd
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM c hcD)
  -- `ζ'` is bounded by `d + h M` on the ball
  have hd' : ∀ w ∈ closedBall c h, ‖deriv riemannZeta w‖ ≤ d + h * M := by
    intro w hw
    have := hconv.norm_image_sub_le_of_norm_deriv_le
      (fun x hx => ZetaZeros.Deriv.differentiableAt_deriv_zeta (h1 x hx)) hM hcD hw
    have hwc : ‖w - c‖ ≤ h := by rw [← dist_eq_norm]; exact hw
    have : M * ‖w - c‖ ≤ h * M := by rw [mul_comm]; exact mul_le_mul_of_nonneg_right hwc hM0
    have := norm_sub_norm_le (deriv riemannZeta w) (deriv riemannZeta c)
    linarith
  have hmv := hconv.norm_image_sub_le_of_norm_deriv_le
    (fun x hx => differentiableAt_riemannZeta (h1 x hx)) hd' hcD hz
  have hzc : ‖z - c‖ ≤ h := by rw [← dist_eq_norm]; exact hz
  have h2 : (d + h * M) * ‖z - c‖ ≤ h * d + h ^ 2 * M := by
    have : (d + h * M) * ‖z - c‖ ≤ (d + h * M) * h := mul_le_mul_of_nonneg_left hzc (by positivity)
    nlinarith
  have hre := Complex.abs_re_le_norm (riemannZeta z - riemannZeta c)
  rw [Complex.sub_re, abs_le] at hre
  linarith

/-- A leg-point certificate gives positivity of `Re ζ` on `[σ - h, σ + h] + iγ`. -/
theorem seg_of_lc {j G N K k fuel Dp m : ℕ} {v d : ℚ} {h : ℝ} (hc : lc j G N K k fuel Dp v d = true)
    (hm : 1 ≤ m) (hγ : 10 ≤ (G : ℝ) / 2 ^ 80) (hh0 : 0 ≤ h) (hh : h ≤ 1 / 16)
    (hpos : h * d + h ^ 2 * M2 m ((G : ℝ) / 2 ^ 80) < v) :
    ∀ σ ∈ Icc ((j : ℝ) / 4096 - h) ((j : ℝ) / 4096 + h),
      0 < (riemannZeta (σ + ((G : ℝ) / 2 ^ 80 : ℝ) * I)).re := by
  intro σ hσ
  obtain ⟨hv, hd⟩ := lc_spec hc
  have hj : (2048 : ℝ) ≤ j := by
    unfold lc at hc; simp only at hc; split at hc
    · simp only [Bool.and_eq_true, Nat.beq_eq, Nat.ble_eq, Nat.blt_eq] at hc
      exact_mod_cast hc.1.1.1.1.2
    · simp at hc
  set c : ℂ := (((j : ℝ) / 4096 : ℝ) : ℂ) + (((G : ℝ) / 2 ^ 80 : ℝ) : ℂ) * I
  have hball : ∀ z ∈ closedBall c h, 7 / 16 ≤ z.re ∧ |z.im - (G : ℝ) / 2 ^ 80| ≤ 1 / 16 := by
    intro z hz
    rw [mem_closedBall, dist_eq_norm] at hz
    have a := Complex.abs_re_le_norm (z - c)
    have b := Complex.abs_im_le_norm (z - c)
    simp only [c, Complex.sub_re, Complex.add_re, Complex.ofReal_re, Complex.mul_re, Complex.ofReal_im,
      Complex.I_re, Complex.I_im, Complex.sub_im, Complex.add_im, Complex.mul_im] at a b
    norm_num at a b
    rw [abs_le] at a
    refine ⟨?_, by linarith⟩
    have : (1 / 2 : ℝ) ≤ (j : ℝ) / 4096 := by rw [le_div_iff₀ (by norm_num)]; linarith
    linarith
  have hz : (σ : ℂ) + ((G : ℝ) / 2 ^ 80 : ℝ) * I ∈ closedBall c h := by
    rw [mem_closedBall, dist_eq_norm]
    have : (σ : ℂ) + ((G : ℝ) / 2 ^ 80 : ℝ) * I - c = ((σ - (j : ℝ) / 4096 : ℝ) : ℂ) := by
      simp only [c]; push_cast; ring
    rw [this, Complex.norm_real, Real.norm_eq_abs, abs_le]
    constructor <;> linarith [hσ.1, hσ.2]
  refine re_pos_of_point hv hd hh0 (fun z hz => norm_zeta''_le_leg hm hγ (hball z hz).1 (hball z hz).2) ?_ hpos _ hz
  intro z hz h1
  have := (hball z hz).2
  rw [h1] at this; simp at this
  rw [abs_le] at this; linarith

theorem cover2 {P : ℝ → Prop} {a b c d : ℝ} (h1 : ∀ σ ∈ Icc a b, P σ) (h2 : ∀ σ ∈ Icc c d, P σ)
    (hcb : c ≤ b) : ∀ σ ∈ Icc a d, P σ := by
  intro σ hσ
  by_cases h : σ ≤ b
  · exact h1 σ ⟨hσ.1, h⟩
  · exact h2 σ ⟨by linarith, hσ.2⟩

end ZetaCert
