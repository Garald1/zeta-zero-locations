/-! The leg at `T = 1000/1` (generated by scripts/gen_bleg.py): `Re ζ(σ + iT) > 0` on
`[1/2, 2]`, and bounds on `ζ(1/2 + iT)` and its argument. -/

namespace ZetaCert.Legs.B1000

open ZetaCert ZetaCert.Window Complex Set

theorem leg_all : ∀ σ ∈ Icc ((2048 : ℕ) / 4096 - (8 : ℝ) / 4096) ((8192 : ℕ) / 4096 + (14 : ℝ) / 4096),
    (fun σ : ℝ => 0 < (riemannZeta (σ + ((1208925819614629174706176000 : ℕ) / 2 ^ 80 : ℝ) * I)).re) σ :=
  cover2 (cover2 (cover2 (cover2 (cover2 (part_0) part_1 (by norm_num)) part_2 (by norm_num)) part_3 (by norm_num)) part_4 (by norm_num)) part_5 (by norm_num)

theorem eT : (((1208925819614629174706176000 : ℕ) : ℝ) / 2 ^ 80 : ℝ) = (1000 : ℝ) / 1 := by norm_num

theorem leg : ∀ σ ∈ Icc (1 / 2 : ℝ) 2, 0 < (riemannZeta (σ + (((1000 : ℝ) / 1 : ℝ) : ℂ) * I)).re := by
  intro σ hσ
  have h := leg_all σ ⟨by norm_num at hσ ⊢; linarith [hσ.1], by norm_num at hσ ⊢; linarith [hσ.2]⟩
  simp only at h; rw [eT] at h; exact h

theorem half : ((177167 : ℝ) / 500000) ≤ (riemannZeta (1 / 2 + (((1000 : ℝ) / 1 : ℝ) : ℂ) * I)).re ∧
    ((929997 : ℝ) / 1000000) ≤ (riemannZeta (1 / 2 + (((1000 : ℝ) / 1 : ℝ) : ℂ) * I)).im ∧
    (riemannZeta (1 / 2 + (((1000 : ℝ) / 1 : ℝ) : ℂ) * I)).im ≤ ((466999 : ℝ) / 500000) := by
  have h := half_point (G := 1208925819614629174706176000) (N := 191) (K := 17) (k := 45) (fuel := 1000) (Dp := 8)
    (v := 177167/500000) (d := 237901/31250) (wlo := 929997/1000000) (whi := 466999/500000) (by decide +kernel)
  rw [eT] at h
  obtain ⟨h1, h2, h3⟩ := h
  refine ⟨le_of_eq_of_le ?_ h1, le_of_eq_of_le ?_ h2, h3.trans (le_of_eq ?_)⟩ <;> norm_num

/-- Bounds on `arg ζ(1/2 + iT)`; numerically (not used) the argument is 1.2056. -/
theorem arg_bd : 0 ≤ (riemannZeta (1 / 2 + (((1000 : ℝ) / 1 : ℝ) : ℂ) * I)).arg ∧
    (riemannZeta (1 / 2 + (((1000 : ℝ) / 1 : ℝ) : ℂ) * I)).arg ≤ Real.pi / 2 := by
  obtain ⟨h1, h2, h3⟩ := half
  exact ⟨(arg_bounds_of_im_nonneg (by norm_num) h1 (by linarith) h3).1,
    (abs_lt.mp ((Complex.abs_arg_lt_pi_div_two_iff).mpr (Or.inl (by linarith)))).2.le⟩

end ZetaCert.Legs.B1000
