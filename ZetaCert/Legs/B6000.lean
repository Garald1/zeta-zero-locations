theorem leg_all : ∀ σ ∈ Icc ((2048 : ℕ) / 4096 - (7 : ℝ) / 4096) ((8192 : ℕ) / 4096 + (8 : ℝ) / 4096),
    (fun σ : ℝ => 0 < (riemannZeta (σ + ((7253554917687775048237056000 : ℕ) / 2 ^ 80 : ℝ) * I)).re) σ :=
  cover2 (cover2 (cover2 (cover2 (cover2 (cover2 (cover2 (cover2 (part_0) part_1 (by norm_num)) part_2 (by norm_num)) part_3 (by norm_num)) part_4 (by norm_num)) part_5 (by norm_num)) part_6 (by norm_num)) part_7 (by norm_num)) part_8 (by norm_num)

theorem eT : (((7253554917687775048237056000 : ℕ) : ℝ) / 2 ^ 80 : ℝ) = (6000 : ℝ) / 1 := by norm_num

theorem leg : ∀ σ ∈ Icc (1 / 2 : ℝ) 2, 0 < (riemannZeta (σ + (((6000 : ℝ) / 1 : ℝ) : ℂ) * I)).re := by
  intro σ hσ
  have h := leg_all σ ⟨by norm_num at hσ ⊢; linarith [hσ.1], by norm_num at hσ ⊢; linarith [hσ.2]⟩
  simp only at h; rw [eT] at h; exact h

theorem half : ((1089257 : ℝ) / 1000000) ≤ (riemannZeta (1 / 2 + (((6000 : ℝ) / 1 : ℝ) : ℂ) * I)).re ∧
    ((-901969 : ℝ) / 500000) ≤ (riemannZeta (1 / 2 + (((6000 : ℝ) / 1 : ℝ) : ℂ) * I)).im ∧
    (riemannZeta (1 / 2 + (((6000 : ℝ) / 1 : ℝ) : ℂ) * I)).im ≤ ((-1799937 : ℝ) / 1000000) := by
  have h := half_point (G := 7253554917687775048237056000) (N := 1087) (K := 20) (k := 55) (fuel := 1000) (Dp := 11)
    (v := 1089257/1000000) (d := 3171071/125000) (wlo := -901969/500000) (whi := -1799937/1000000) (by decide +kernel)
  rw [eT] at h
  obtain ⟨h1, h2, h3⟩ := h
  refine ⟨le_of_eq_of_le ?_ h1, le_of_eq_of_le ?_ h2, h3.trans (le_of_eq ?_)⟩ <;> norm_num

/-- Bounds on `arg ζ(1/2 + iT)`; numerically (not used) the argument is -1.0263. -/
theorem arg_bd : -(Real.pi / 2) ≤ (riemannZeta (1 / 2 + (((6000 : ℝ) / 1 : ℝ) : ℂ) * I)).arg ∧
    (riemannZeta (1 / 2 + (((6000 : ℝ) / 1 : ℝ) : ℂ) * I)).arg ≤ 0 := by
  obtain ⟨h1, h2, h3⟩ := half
  exact ⟨(abs_lt.mp ((Complex.abs_arg_lt_pi_div_two_iff).mpr (Or.inl (by linarith)))).1.le,
    (arg_bounds_of_im_neg (by norm_num) h1 (by linarith) h2).2⟩

