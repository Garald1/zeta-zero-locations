/-! The leg at `T = 3/1` (generated by scripts/gen_bleg.py): `Re ζ(σ + iT) > 0` on
`[1/2, 2]`, and bounds on `ζ(1/2 + iT)` and its argument. -/

namespace ZetaCert.Legs.B3

open ZetaCert ZetaCert.Window Complex Set

theorem leg_all : ∀ σ ∈ Icc ((2048 : ℕ) / 4096 - (91 : ℝ) / 4096) ((8166 : ℕ) / 4096 + (112 : ℝ) / 4096),
    (fun σ : ℝ => 0 < (riemannZeta (σ + ((3626777458843887524118528 : ℕ) / 2 ^ 80 : ℝ) * I)).re) σ :=
  part_0

theorem eT : (((3626777458843887524118528 : ℕ) : ℝ) / 2 ^ 80 : ℝ) = (3 : ℝ) / 1 := by norm_num

theorem leg : ∀ σ ∈ Icc (1 / 2 : ℝ) 2, 0 < (riemannZeta (σ + (((3 : ℝ) / 1 : ℝ) : ℂ) * I)).re := by
  intro σ hσ
  have h := leg_all σ ⟨by norm_num at hσ ⊢; linarith [hσ.1], by norm_num at hσ ⊢; linarith [hσ.2]⟩
  simp only at h; rw [eT] at h; exact h

theorem half : ((33171 : ℝ) / 62500) ≤ (riemannZeta (1 / 2 + (((3 : ℝ) / 1 : ℝ) : ℂ) * I)).re ∧
    ((-80897 : ℝ) / 1000000) ≤ (riemannZeta (1 / 2 + (((3 : ℝ) / 1 : ℝ) : ℂ) * I)).im ∧
    (riemannZeta (1 / 2 + (((3 : ℝ) / 1 : ℝ) : ℂ) * I)).im ≤ ((-2403 : ℝ) / 31250) := by
  have h := half_point (G := 3626777458843887524118528) (N := 5) (K := 7) (k := 4) (fuel := 1000) (Dp := 3)
    (v := 33171/62500) (d := 16681/62500) (wlo := -80897/1000000) (whi := -2403/31250) (by decide +kernel)
  rw [eT] at h
  obtain ⟨h1, h2, h3⟩ := h
  refine ⟨le_of_eq_of_le ?_ h1, le_of_eq_of_le ?_ h2, h3.trans (le_of_eq ?_)⟩ <;> norm_num

/-- Bounds on `arg ζ(1/2 + iT)`; numerically (not used) the argument is -0.1470. -/
theorem arg_bd : ((-80897 : ℝ) / 1000000) / ((33171 : ℝ) / 62500) ≤ (riemannZeta (1 / 2 + (((3 : ℝ) / 1 : ℝ) : ℂ) * I)).arg ∧
    (riemannZeta (1 / 2 + (((3 : ℝ) / 1 : ℝ) : ℂ) * I)).arg ≤ 0 := by
  obtain ⟨h1, h2, h3⟩ := half
  exact arg_bounds_of_im_neg (by norm_num) h1 (by linarith) h2

end ZetaCert.Legs.B3
